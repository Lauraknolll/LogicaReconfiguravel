set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C35F672C6
set_global_assignment -name TOP_LEVEL_ENTITY CRONOMETRO
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_CREATION_TIME_DATE "13:33:12  SEPTEMBER 02, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (VHDL)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT VHDL -section_id eda_simulation
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name VHDL_FILE bcd_para_7seg.vhd
set_global_assignment -name VHDL_FILE CONT_16.vhd
set_global_assignment -name VHDL_FILE CRONOMETRO.vhd
set_global_assignment -name VHDL_FILE CRONOMETRO_tb.vhd
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name VHDL_FILE DIVISOR_10ms.vhd
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# ==============================================================================
# Clock Principal (50 MHz)
# ==============================================================================
set_location_assignment PIN_N2 -to CLK

# ==============================================================================
# Displays de 7 Segmentos (HEX0 a HEX3)
# ==============================================================================
# HEX0: Unidades dos Centésimos
set_location_assignment PIN_AF10 -to CENTESIMOS_UNIDADE_7SEG[0]
set_location_assignment PIN_AB12 -to CENTESIMOS_UNIDADE_7SEG[1]
set_location_assignment PIN_AC12 -to CENTESIMOS_UNIDADE_7SEG[2]
set_location_assignment PIN_AD11 -to CENTESIMOS_UNIDADE_7SEG[3]
set_location_assignment PIN_AE11 -to CENTESIMOS_UNIDADE_7SEG[4]
set_location_assignment PIN_V14 -to CENTESIMOS_UNIDADE_7SEG[5]
set_location_assignment PIN_V13 -to CENTESIMOS_UNIDADE_7SEG[6]

# HEX1: Dezenas dos Centésimos
set_location_assignment PIN_V20 -to CENTESIMOS_DEZENA_7SEG[0]
set_location_assignment PIN_V21 -to CENTESIMOS_DEZENA_7SEG[1]
set_location_assignment PIN_W21 -to CENTESIMOS_DEZENA_7SEG[2]
set_location_assignment PIN_Y22 -to CENTESIMOS_DEZENA_7SEG[3]
set_location_assignment PIN_AA24 -to CENTESIMOS_DEZENA_7SEG[4]
set_location_assignment PIN_AA23 -to CENTESIMOS_DEZENA_7SEG[5]
set_location_assignment PIN_AB24 -to CENTESIMOS_DEZENA_7SEG[6]

# HEX2: Unidades dos Segundos
set_location_assignment PIN_AB23 -to SEGUNDOS_UNIDADE_7SEG[0]
set_location_assignment PIN_V22 -to SEGUNDOS_UNIDADE_7SEG[1]
set_location_assignment PIN_AC25 -to SEGUNDOS_UNIDADE_7SEG[2]
set_location_assignment PIN_AC26 -to SEGUNDOS_UNIDADE_7SEG[3]
set_location_assignment PIN_AB26 -to SEGUNDOS_UNIDADE_7SEG[4]
set_location_assignment PIN_AB25 -to SEGUNDOS_UNIDADE_7SEG[5]
set_location_assignment PIN_Y24 -to SEGUNDOS_UNIDADE_7SEG[6]

# HEX3: Dezenas dos Segundos
set_location_assignment PIN_Y23 -to SEGUNDOS_DEZENA_7SEG[0]
set_location_assignment PIN_AA25 -to SEGUNDOS_DEZENA_7SEG[1]
set_location_assignment PIN_AA26 -to SEGUNDOS_DEZENA_7SEG[2]
set_location_assignment PIN_Y26 -to SEGUNDOS_DEZENA_7SEG[3]
set_location_assignment PIN_Y25 -to SEGUNDOS_DEZENA_7SEG[4]
set_location_assignment PIN_U22 -to SEGUNDOS_DEZENA_7SEG[5]
set_location_assignment PIN_W24 -to SEGUNDOS_DEZENA_7SEG[6]

# ==============================================================================
# LEDs Vermelhos (LEDR0 a LEDR15)
# ==============================================================================
# Centésimos: LEDR[0..7]
set_location_assignment PIN_AE23 -to CENTESIMOS[0]
set_location_assignment PIN_AF23 -to CENTESIMOS[1]
set_location_assignment PIN_AB21 -to CENTESIMOS[2]
set_location_assignment PIN_AC22 -to CENTESIMOS[3]
set_location_assignment PIN_AD22 -to CENTESIMOS[4]
set_location_assignment PIN_AD23 -to CENTESIMOS[5]
set_location_assignment PIN_AD21 -to CENTESIMOS[6]
set_location_assignment PIN_AC21 -to CENTESIMOS[7]

# Segundos: LEDR[8..15]
set_location_assignment PIN_AA14 -to SEGUNDOS[0]
set_location_assignment PIN_Y13 -to SEGUNDOS[1]
set_location_assignment PIN_AA13 -to SEGUNDOS[2]
set_location_assignment PIN_AC14 -to SEGUNDOS[3]
set_location_assignment PIN_AD15 -to SEGUNDOS[4]
set_location_assignment PIN_AE15 -to SEGUNDOS[5]
set_location_assignment PIN_AF13 -to SEGUNDOS[6]
set_location_assignment PIN_AE13 -to SEGUNDOS[7]

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top